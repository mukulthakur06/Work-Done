# Workdone Application Environment Variables
# Copy to .env and replace placeholders with your actual configuration

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Session & Security
# Generate a strong 32+ character random secret for production
SESSION_SECRET=workdone_secret_key_change_in_production_min32chars
CSRF_SECRET=workdone_csrf_secret_random_token_key

# PostgreSQL Database URL (Production / Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://workdone_user:your_secure_password@localhost:5432/workdone_db?schema=public"

# SQLite Database File Path (Local fallback / embedded development)
SQLITE_DB_PATH="./data/workdone.db"

# Object Storage / Uploads (S3, Cloudflare R2, or local storage)
STORAGE_PROVIDER=local # local | s3 | r2
STORAGE_BUCKET_NAME=workdone-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your_access_key_placeholder
STORAGE_SECRET_ACCESS_KEY=your_secret_key_placeholder
UPLOAD_DIR="./public/uploads"

# Geocoding & Maps Provider (Google Maps, Mapbox, or OpenStreetMap)
MAPS_PROVIDER=osm # osm | google | mapbox
MAPS_API_KEY=your_maps_api_key_placeholder

# Email Notifications (Resend, SendGrid, or SMTP)
EMAIL_PROVIDER=console # console | smtp | resend | sendgrid
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Workdone Marketplace <notifications@workdone.local>"

# SMS Provider (Twilio or similar, optional phone verification)
SMS_PROVIDER=disabled # disabled | twilio
TWILIO_ACCOUNT_SID=your_twilio_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=your_twilio_phone_number_placeholder
